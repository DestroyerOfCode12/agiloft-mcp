{
  "name": "agiloft-control",
  "private": true,
  "description": "Agiloft Control: MCP server and administration console for governed Agiloft access",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agiloft-control/api dev",
    "dev:console": "pnpm --filter @agiloft-control/console dev",
    "demo": "pnpm build && pnpm --filter @agiloft-control/api start",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @agiloft-control/core migrate",
    "mcp:stdio": "pnpm --filter @agiloft-control/mcp-server start:stdio",
    "mcp:inspect": "pnpm --filter @agiloft-control/mcp-server inspect",
    "docs:capabilities": "tsx scripts/gen-capability-matrix.ts && prettier --write docs/capability-matrix.md"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
