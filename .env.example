# Agiloft Control configuration. Copy to .env and adjust. Never commit .env.
# Full reference: docs/configuration.md

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                  # production refuses dev login, MCP dev tokens and PGlite
LOG_LEVEL=info
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080 # must be https:// in production

# --- Database ----------------------------------------------------------------
# PostgreSQL for anything shared or deployed. pglite:<dir> is a single-process
# local convenience; pglite:memory is for tests.
DATABASE_URL=pglite:./.data/pglite
# DATABASE_URL=postgres://agiloft_control:password@localhost:5432/agiloft_control

# --- Secrets -----------------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Required in production. Without it a temporary key is used and stored Agiloft
# credentials become unreadable after a restart.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1

# --- Console authentication ----------------------------------------------------
AUTH_MODE=dev                         # dev (local only) | oidc
# OIDC_ISSUER=https://login.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SESSION_TTL_HOURS=12

# --- Demo ----------------------------------------------------------------------
DEMO_MODE=true                        # seeds the synthetic demo connection

# --- Agiloft destinations (SSRF allow-list) -------------------------------------
AGILOFT_ALLOWED_HOST_SUFFIXES=agiloft.com
AGILOFT_ONPREM_HOSTS=                 # comma-separated exact hostnames/IPs of approved on-prem KBs
AGILOFT_TIMEOUT_MS=20000

# --- Worker ----------------------------------------------------------------------
WORKER_EMBEDDED=true                  # false when running apps/worker separately (PostgreSQL only)
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=60

# --- Audit -----------------------------------------------------------------------
AUDIT_RETENTION_DAYS=365

# --- MCP ---------------------------------------------------------------------------
MCP_STDIO_USER_EMAIL=oli.operator@demo.local
MCP_HTTP_PORT=8090
MCP_RESOURCE_URL=http://localhost:8090/mcp
# Remote MCP via your identity provider (OAuth 2.1 resource server):
# MCP_OAUTH_ISSUER=https://login.example.com/
# MCP_OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://agiloft-control.example.com/mcp
# Local development only (refused in production): static bearer token for /mcp
# MCP_DEV_TOKEN=change-me-to-a-long-random-string
# MCP_DEV_TOKEN_USER_EMAIL=oli.operator@demo.local
MCP_ALLOWED_ORIGIN_HOSTS=

# --- Optional model provider (scenario interpretation only) -----------------------
MODEL_PROVIDER=none                   # none | anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
